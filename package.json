{
  "name": "sonkoflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && tsc",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test",
    "dev:server": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "start": "node --env-file-if-exists=.env server.js",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:all": "npm run test:unit && npm test && npm run test:browser",
    "maintenance": "node --env-file-if-exists=.env build/maintenance.js",
    "test:live": "node --env-file-if-exists=.env --import tsx --test tests/live/*.test.ts",
    "test:browser": "playwright test --config playwright.foundation.config.js",
    "setup:local": "node scripts/setup-local.mjs",
    "check:services": "node --env-file-if-exists=.env --import tsx scripts/check-services.ts",
    "postinstall": "npm run build",
    "check:processing": "node --env-file-if-exists=.env --import tsx scripts/check-processing.ts",
    "test:live:processing": "node --env-file-if-exists=.env --import tsx --test tests/live/processing.test.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@playwright/test": "^1.56.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "undici": "^7.30.1",
    "vite": "^7.1.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
