# Server only. No VITE_ variables or browser credentials are needed.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Generate each locally with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_ENCRYPTION_KEY=
RATE_LIMIT_KEY=
# Keep 0 until Hostinger's trusted reverse-proxy topology has been confirmed.
# Never trust arbitrary forwarded headers. Behind a confirmed single proxy, set 1.
TRUST_PROXY_HOPS=0
