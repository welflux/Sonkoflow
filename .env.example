# Server only. No VITE_ variables or browser credentials are needed.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Generate each locally with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_ENCRYPTION_KEY=
RATE_LIMIT_KEY=
# Keep 0 until Hostinger's trusted reverse-proxy topology has been confirmed.
# Never trust arbitrary forwarded headers. Behind a confirmed single proxy, set 1.
TRUST_PROXY_HOPS=0


# Phase 2 is optional and fails closed; Phase 1 stays usable without these.
AI_PROCESSING_ENABLED=0
# Server-only credential. Never use a VITE_ prefix.
AI_OPENAI_API_KEY=
# Editing-precision default, verified against official model docs 2026-10-28.
AI_IMAGE_MODEL=gpt-image-2.5-sunburst-2026-09-08
AI_MAX_QUALITY=high
AI_TIMEOUT_SECONDS=300
AI_GLOBAL_CONCURRENCY=1
AI_USER_DAILY_LIMIT=5
AI_GLOBAL_DAILY_LIMIT=20
# Set a conservative per-operation reservation and daily reservation budgets.
# These are application admission controls, not provider invoice ceilings.
AI_OPERATION_RESERVE_USD=
AI_USER_DAILY_BUDGET_USD=
AI_GLOBAL_DAILY_BUDGET_USD=
# Verify CURRENT official pricing for the exact configured model before enabling.
# No sample numeric rates are supplied: invented prices must not reach production.
AI_PRICE_VERSION=
AI_TEXT_INPUT_USD_PER_MILLION=
AI_IMAGE_INPUT_USD_PER_MILLION=
# Optional only when text output is not priced/reported; estimates stay unknown if needed.
AI_TEXT_OUTPUT_USD_PER_MILLION=
AI_IMAGE_OUTPUT_USD_PER_MILLION=

# Phase 3: product checks always use local image analysis; optional vision adds API usage.
AI_PRODUCT_RETRY_LIMIT=2
AI_QUALITY_VISION_ENABLED=0
# Current supported model, verified 2026-10-28; no tools or external image URLs.
AI_QUALITY_VISION_MODEL=gpt-6.1-terra
# Additional per-job reservation, included in existing daily admission budgets.
AI_QUALITY_RESERVE_USD=
# Verified standard uncached vision token rates: input 1, output 5 USD per million.
# Fill explicitly when enabling; provider billing remains authoritative.
AI_QUALITY_INPUT_USD_PER_MILLION=
AI_QUALITY_OUTPUT_USD_PER_MILLION=
AI_QUALITY_PRICE_VERSION=
