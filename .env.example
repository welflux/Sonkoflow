# Server only. No VITE_ variables or browser credentials are needed.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Generate each locally with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_ENCRYPTION_KEY=
RATE_LIMIT_KEY=
# Keep 0 until Hostinger's trusted reverse-proxy topology has been confirmed.
# Never trust arbitrary forwarded headers. Behind a confirmed single proxy, set 1.
TRUST_PROXY_HOPS=0


# Phase 2 is optional and fails closed; Phase 1 stays usable without these.
AI_PROCESSING_ENABLED=0
# Server-only credential. Never use a VITE_ prefix.
AI_OPENAI_API_KEY=
# Editing-precision default, verified against official model docs 2026-10-28.
AI_IMAGE_MODEL=gpt-image-2.5-sunburst-2026-09-08
AI_MAX_QUALITY=high
AI_TIMEOUT_SECONDS=300
AI_GLOBAL_CONCURRENCY=1
AI_USER_DAILY_LIMIT=5
AI_GLOBAL_DAILY_LIMIT=20
# Set a conservative per-operation reservation and daily reservation budgets.
# These are application admission controls, not provider invoice ceilings.
AI_OPERATION_RESERVE_USD=
AI_USER_DAILY_BUDGET_USD=
AI_GLOBAL_DAILY_BUDGET_USD=
# Verify CURRENT official pricing for the exact configured model before enabling.
# No sample numeric rates are supplied: invented prices must not reach production.
AI_PRICE_VERSION=
AI_TEXT_INPUT_USD_PER_MILLION=
AI_IMAGE_INPUT_USD_PER_MILLION=
# Optional only when text output is not priced/reported; estimates stay unknown if needed.
AI_TEXT_OUTPUT_USD_PER_MILLION=
AI_IMAGE_OUTPUT_USD_PER_MILLION=

# Phase 3: product checks always use local image analysis; optional vision adds API usage.
AI_PRODUCT_RETRY_LIMIT=2
AI_QUALITY_VISION_ENABLED=0
# Current supported model, verified 2026-10-28; no tools or external image URLs.
AI_QUALITY_VISION_MODEL=gpt-6.1-terra
# Additional per-job reservation, included in existing daily admission budgets.
AI_QUALITY_RESERVE_USD=
# Verified standard uncached vision token rates: input 1, output 5 USD per million.
# Fill explicitly when enabling; provider billing remains authoritative.
AI_QUALITY_INPUT_USD_PER_MILLION=
AI_QUALITY_OUTPUT_USD_PER_MILLION=
AI_QUALITY_PRICE_VERSION=

# Phase 4: packs reuse the existing generation/assessment workers and provider caps.
AI_PACKS_ENABLED=0
# Internal usage allowance, not a purchase or subscription. A one-time grant only.
AI_PACK_INITIAL_CREDITS=0
# Micro-USD of accounted provider use represented by one internal credit.
AI_PACK_CREDIT_MICRO_USD=
AI_PACK_MAX_OUTPUTS=5
AI_PACK_DAILY_LIMIT=2
AI_PACK_ACTIVE_LIMIT=1
AI_PACK_ZIP_CONCURRENCY=1
AI_PACK_RESERVE_MULTIPLIER=1.5
# Required only when optional vision assessment is enabled. Use reviewed estimates.
AI_PACK_VISION_INPUT_TOKEN_ESTIMATE=
# REQUIRED model-specific, versioned estimates, reviewed against real usage.
# Schema is documented in docs/phase-4-product-packs.md; no invented production tokens.
AI_PACK_TOKEN_ESTIMATES_JSON=

# Bulk orchestration uses the existing worker, packs and allowance ledger.
AI_BATCH_MAX_IMAGES=5
AI_BATCH_MAX_BYTES=52428800
AI_BATCH_DAILY_LIMIT=2
AI_BATCH_FILE_BYTES=10485760
AI_BATCH_FORMATS=image/jpeg,image/png,image/webp

# Commercial pricing: install migration 202610280007, review/calibrate provider costs,
# clear legacy holds and reconcile legacy wallet balances BEFORE activation.
# Operator runbook: docs/pricing-and-paypal.md. Both flags fail closed by default.
BILLING_ENABLED=0
BILLING_PROVIDER_VERIFIED=0
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
# Actual precreated, verified PayPal recurring plans, matching USD catalog exactly.
# Annual selectors remain hidden until BOTH annual merchant plans are configured.
PAYPAL_PLAN_IDS={}

# Optional Google OAuth uses the existing Supabase provider, server PKCE and session cookies.
# Keep off until Google credentials and exact redirect allowlists are verified.
AUTH_GOOGLE_ENABLED=0
